generator client {
  provider      = "prisma-client-js"
  // Vercel serverless (Amazon Linux 2023) needs the RHEL OpenSSL 3 engine
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum ProfessionalRole {
  ergotherapeute
  kinesitherapeute
  infirmier
  educateur
  admin_etablissement
}

enum CaregiverActionType {
  realise_succes
  essaye
  doute
  aide
  note
}

enum AutonomyLevel {
  autonome
  semi_autonome_faible
  semi_autonome_eleve
  dependant
  grabataire
}

enum Skill {
  transfert
  fauteuil
  toilette
  communication
  repas
  mobilite
  autonomie
  comportement
  autre
}

enum ObjectiveStatus {
  acquis
  en_cours
  a_reprendre
  non_travaille
}

enum CaregiverStatus {
  invite
  actif
  parcours_propose_non_active
}

enum ComprehensionResult {
  clair
  doute
}

enum FeedbackOutcome {
  facile
  difficile
  non_essaye
}

enum QuestionStatus {
  en_attente
  traitee
  associee_ressource
}

enum MessageSection {
  a_retenir
  a_essayer
  a_eviter
  a_revoir_ensemble
}

enum AutonomyLevelStatus {
  provisoire
  confirme
  confirme_ajuste
}

enum AutonomyLevelSource {
  declare_aidant
  professionnel
}

enum AutonomyHistorySource {
  question_aidant
  rappel_periodique
  signal_exercice
  professionnel
}

enum AutonomyAlertType {
  profil_a_confirmer
  proposition_upgrade
  proposition_downgrade
}

enum AutonomyAlertStatus {
  en_attente
  confirme
  ajuste
  ignore
}

enum AutonomyAlertAudience {
  professionnel
  aidant
}

enum ExercisePublicationStatus {
  brouillon
  a_valider
  publie
  archive
}

enum PatientExerciseStatus {
  propose
  actif
  en_cours
  reussi
  essai
  echec
  acquis
}

enum ExerciseAttemptOutcome {
  reussi
  essai
  echec
}

enum ProfessionalAlertType {
  level_change_proposed
  regression_suspected
  no_fallback
}

enum ProfessionalAlertStatus {
  ouverte
  traitee
  ignoree
}


// --- Models ---

model Establishment {
  id                         String         @id @default(cuid())
  name                       String
  autonomyReviewIntervalDays Int            @default(15)
  createdAt                  DateTime       @default(now())
  professionals              Professional[]
  patients                   Patient[]
}

model User {
  id               String          @id @default(cuid())
  email            String?         @unique
  phone            String?
  passwordHash     String
  firstName        String
  lastName         String
  largeText        Boolean         @default(false)
  soberMode        Boolean         @default(false)
  onboardingDone   Boolean         @default(false)
  isPlatformAdmin  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  professional     Professional?
  caregiver        Caregiver?
}

model Professional {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            ProfessionalRole
  establishmentId String
  establishment   Establishment    @relation(fields: [establishmentId], references: [id])
  visits          VisitProfessional[]
  transmissions   Transmission[]
  questions       Question[]       @relation("QuestionProfessional")
  clinicalNotes   ClinicalNote[]
  activatedExercises PatientExercise[]
  treatedAlerts   ProfessionalAlert[] @relation("AlertTreatedBy")
}

model Caregiver {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    CaregiverStatus   @default(invite)
  patients  PatientCaregiver[]
  feedbacks CaregiverFeedback[]
  questions Question[]
  actions   CaregiverAction[]
}

model Patient {
  id                       String                 @id @default(cuid())
  firstName                String
  lastName                 String
  autonomyLevel            AutonomyLevel          @default(semi_autonome_faible)
  autonomyLevelStatus      AutonomyLevelStatus?
  autonomyLevelSource      AutonomyLevelSource?
  autonomyLevelSetAt       DateTime?
  autonomyLevelReviewDueAt DateTime?
  girLevel                 Int?
  establishmentId          String
  establishment            Establishment         @relation(fields: [establishmentId], references: [id])
  caregivers               PatientCaregiver[]
  objectives               EducationalObjective[]
  visits                   Visit[]
  autonomyHistory          AutonomyLevelHistory[]
  autonomyAlerts           AutonomyAlert[]
  patientExercises         PatientExercise[]
  professionalAlerts       ProfessionalAlert[]
  createdAt                DateTime               @default(now())
}

model AutonomyLevelHistory {
  id            String                @id @default(cuid())
  patientId     String
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  autonomyLevel AutonomyLevel
  source        AutonomyHistorySource
  setByUserId   String?
  setAt         DateTime              @default(now())
}

model AutonomyAlert {
  id            String                @id @default(cuid())
  patientId     String
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type          AutonomyAlertType
  status        AutonomyAlertStatus   @default(en_attente)
  audience      AutonomyAlertAudience
  proposedLevel AutonomyLevel?
  message       String
  createdAt     DateTime              @default(now())
  resolvedAt    DateTime?
}
model PatientCaregiver {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId String
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  relationship String
  isPrimary   Boolean   @default(true)

  @@unique([patientId, caregiverId])
}

model EducationalObjective {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  skill       Skill
  status      ObjectiveStatus @default(en_cours)
  instructions String
  nextStep    String?
  isCurrent   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  transmissions Transmission[]
}

model Visit {
  id            String              @id @default(cuid())
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          DateTime            @default(now())
  professionals VisitProfessional[]
  transmission  Transmission?
}

model VisitProfessional {
  id             String       @id @default(cuid())
  visitId        String
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@unique([visitId, professionalId])
}

model Transmission {
  id          String               @id @default(cuid())
  visitId     String               @unique
  visit       Visit                @relation(fields: [visitId], references: [id], onDelete: Cascade)
  objectiveId String
  objective   EducationalObjective @relation(fields: [objectiveId], references: [id])
  professionalId String
  professional Professional        @relation(fields: [professionalId], references: [id])
  messages    TransmissionMessage[]
  sentAt      DateTime             @default(now())
  readAt      DateTime?
  comprehensionChecks ComprehensionCheck[]
  feedbacks   CaregiverFeedback[]
  actions     CaregiverAction[]
}

model CaregiverAction {
  id             String             @id @default(cuid())
  transmissionId String
  transmission   Transmission       @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  caregiverId    String
  caregiver      Caregiver          @relation(fields: [caregiverId], references: [id])
  type           CaregiverActionType
  stepLabel      String?
  note           String?
  createdAt      DateTime           @default(now())
}

model TransmissionMessage {
  id             String       @id @default(cuid())
  transmissionId String
  transmission   Transmission @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  section        MessageSection
  theme          String?
  content        String
}

model ComprehensionCheck {
  id             String              @id @default(cuid())
  transmissionId String
  transmission   Transmission        @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  result         ComprehensionResult
  comment        String?
  createdAt      DateTime            @default(now())
}

model CaregiverFeedback {
  id             String          @id @default(cuid())
  transmissionId String
  transmission   Transmission    @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  caregiverId    String
  caregiver      Caregiver       @relation(fields: [caregiverId], references: [id])
  outcome        FeedbackOutcome
  difficulties   String
  wantsToDiscuss Boolean         @default(false)
  treated        Boolean         @default(false)
  createdAt      DateTime        @default(now())
}

model Question {
  id             String         @id @default(cuid())
  caregiverId    String
  caregiver      Caregiver      @relation(fields: [caregiverId], references: [id])
  professionalId String?
  professional   Professional?  @relation("QuestionProfessional", fields: [professionalId], references: [id])
  text           String
  status         QuestionStatus @default(en_attente)
  answer         String?
  createdAt      DateTime       @default(now())
}

model Resource {
  id       String @id @default(cuid())
  category String
  title    String
  content  String
}

// Données professionnelles — jamais visibles par l'aidant
model ClinicalNote {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  patientId      String
  content        String
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

// --- Catalogue exercices (specs §10–12) ---

model Theme {
  id           String     @id @default(cuid())
  slug         String     @unique
  label        String
  icon         String?
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  exercises    Exercise[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Échelle A–E administrable (distincte de l'enum Patient.autonomyLevel)
model AutonomyScale {
  id           String        @id @default(cuid())
  code         String        @unique
  label        String
  patientEnum  AutonomyLevel
  displayOrder Int           @default(0)
  active       Boolean       @default(true)
  exercises    Exercise[]
}

model Exercise {
  id                   String                    @id @default(cuid())
  themeId              String
  theme                Theme                     @relation(fields: [themeId], references: [id])
  autonomyScaleId      String
  autonomyScale        AutonomyScale             @relation(fields: [autonomyScaleId], references: [id])
  tier                 Int                       @default(1)
  name                 String
  objective            String
  /// JSON string[] — étapes / guidance verbale
  steps                String
  /// JSON string[]
  caregiverCan         String
  /// JSON string[]
  caregiverMustNot     String
  estimatedDuration    String?
  risks                String?
  onSuccessExerciseId  String?
  onSuccessExercise    Exercise?                 @relation("ExerciseOnSuccess", fields: [onSuccessExerciseId], references: [id])
  successFrom          Exercise[]                @relation("ExerciseOnSuccess")
  onPartialExerciseId  String?
  onPartialExercise    Exercise?                 @relation("ExerciseOnPartial", fields: [onPartialExerciseId], references: [id])
  partialFrom          Exercise[]                @relation("ExerciseOnPartial")
  onFailureExerciseId  String?
  onFailureExercise    Exercise?                 @relation("ExerciseOnFailure", fields: [onFailureExerciseId], references: [id])
  failureFrom          Exercise[]                @relation("ExerciseOnFailure")
  crossesAutonomyLevel Boolean                   @default(false)
  alertOnFailure       Boolean                   @default(false)
  status               ExercisePublicationStatus @default(brouillon)
  version              Int                       @default(1)
  validatedBy          String?
  validatedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  patientExercises     PatientExercise[]
  alerts               ProfessionalAlert[]

  @@index([themeId, status])
  @@index([autonomyScaleId])
}

model PatientExercise {
  id            String                @id @default(cuid())
  patientId     String
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise              @relation(fields: [exerciseId], references: [id])
  currentStatus PatientExerciseStatus @default(propose)
  activatedById String?
  activatedBy   Professional?         @relation(fields: [activatedById], references: [id])
  activatedAt   DateTime?
  /// Contenu courant pour ce thème (un seul true par patient×thème côté app)
  isCurrent     Boolean               @default(false)
  history       ExerciseAttempt[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([patientId, isCurrent])
  @@unique([patientId, exerciseId])
}

model ExerciseAttempt {
  id                String                 @id @default(cuid())
  patientExerciseId String
  patientExercise   PatientExercise        @relation(fields: [patientExerciseId], references: [id], onDelete: Cascade)
  outcome           ExerciseAttemptOutcome
  note              String?
  createdAt         DateTime               @default(now())
}

model ProfessionalAlert {
  id             String                  @id @default(cuid())
  type           ProfessionalAlertType
  status         ProfessionalAlertStatus @default(ouverte)
  patientId      String
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseId     String?
  exercise       Exercise?               @relation(fields: [exerciseId], references: [id])
  nextExerciseId String?
  message        String
  treatedById    String?
  treatedBy      Professional?           @relation("AlertTreatedBy", fields: [treatedById], references: [id])
  createdAt      DateTime                @default(now())
  treatedAt      DateTime?

  @@index([patientId, status])
}

// =============================================================================
// Community / marketing (AD-2, AD-3) — aucune jointure clinique
// =============================================================================

enum CommunityAppVersionType {
  vercel_preview
}

enum CommunityBetaLeadStatus {
  nouveau
  invite
  refuse
  archive
}

enum CommunityBetaTesterStatus {
  invite
  actif
  revoque
}

enum CommunityConsentPurpose {
  beta
  newsletter
}

enum CommunityPublicationKind {
  classique
  carrousel
  video
}

enum CommunityPublicationStatus {
  draft
  scheduled
  ready
  published
  cancelled
  failed
}

enum CommunitySocialChannel {
  instagram
  threads
  tiktok
  facebook
}

enum CommunityGeoFormat {
  definition_glossaire
  faq_qr
  guide_howto
  comparatif
  checklist
  tldr_resume
  liste_structuree
  fiche_pratique
}

enum CommunityBlogStatus {
  brouillon
  publie
  exporte
  archive
}

enum CommunityTemplateKind {
  classique
  video
  both
}

/// Version Preview Vercel pour invitations bêta (FR10, AD-9)
model CommunityAppVersion {
  id          String                   @id @default(cuid())
  label       String
  type        CommunityAppVersionType  @default(vercel_preview)
  previewUrl  String
  notes       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  testers     CommunityBetaTester[]
}

model CommunityConsentProof {
  id              String                   @id @default(cuid())
  purpose         CommunityConsentPurpose
  purposeText     String
  textVersion     String
  origin          String                   @default("landing")
  consentedAt     DateTime                 @default(now())
  betaLeadId      String?
  betaLead        CommunityBetaLead?       @relation(fields: [betaLeadId], references: [id], onDelete: Cascade)
  createdAt       DateTime                 @default(now())

  @@index([betaLeadId, purpose])
}

model CommunityBetaLead {
  id                   String                   @id @default(cuid())
  email                String
  firstName            String
  profile              String
  motivation           String?
  status               CommunityBetaLeadStatus  @default(nouveau)
  newsletterOptIn      Boolean                  @default(false)
  brevoSyncedAt        DateTime?
  brevoSyncError       String?
  consents             CommunityConsentProof[]
  tester               CommunityBetaTester?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model CommunityBetaTester {
  id           String                     @id @default(cuid())
  leadId       String                     @unique
  lead         CommunityBetaLead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  appVersionId String
  appVersion   CommunityAppVersion        @relation(fields: [appVersionId], references: [id])
  status       CommunityBetaTesterStatus  @default(invite)
  inviteNote   String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([status])
}

model CommunityMediaAsset {
  id           String   @id @default(cuid())
  label        String
  url          String
  mimeType     String?
  license      String
  source       String
  provenance   String?
  width        Int?
  height       Int?
  isPosePack   Boolean  @default(false)
  poseKey      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publicationAssets CommunityPublicationAsset[]
}

model CommunityTheme {
  id               String   @id @default(cuid())
  slug             String   @unique
  label            String
  description      String
  networksJson     String
  formatsJson      String
  suggestedTagsJson String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  publications     CommunityPublication[]
  articles         CommunityBlogArticle[]
  templates        CommunityTemplate[]
  bearScenarios    CommunityBearScenario[]
}

model CommunityTemplate {
  id        String                 @id @default(cuid())
  name      String
  body      String
  kind      CommunityTemplateKind  @default(both)
  themeId   String?
  theme     CommunityTheme?        @relation(fields: [themeId], references: [id])
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model CommunityBearScenario {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  bearRole        String
  beatSheetJson   String
  suggestedTagsJson String
  themeId         String?
  theme           CommunityTheme? @relation(fields: [themeId], references: [id])
  poseKeysJson    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publications    CommunityPublication[]
}

model CommunitySocialAccount {
  id        String                 @id @default(cuid())
  channel   CommunitySocialChannel
  label     String
  url       String
  active    Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  targets   CommunityPublicationTarget[]

  @@unique([channel, url])
}

model CommunityRightsAttestation {
  id             String   @id @default(cuid())
  label          String
  fileUrl        String?
  notes          String?
  archivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  publications   CommunityPublication[]
}

model CommunityPublication {
  id                String                     @id @default(cuid())
  kind              CommunityPublicationKind
  status            CommunityPublicationStatus @default(draft)
  title             String?
  body              String
  tagsJson          String                     @default("[]")
  themeId           String?
  theme             CommunityTheme?            @relation(fields: [themeId], references: [id])
  bearScenarioId    String?
  bearScenario      CommunityBearScenario?     @relation(fields: [bearScenarioId], references: [id])
  bearEnabled       Boolean                    @default(true)
  poseKey           String?
  /// Couleur texte titre / overlay (hex, ex. #5B6BC0)
  titleColor        String?
  /// Couleur sous-titre / corps overlay (hex)
  subtitleColor     String?
  /// Clé scène référentiel (ex. scene-communication) — ours en situation
  sceneKey          String?
  /// Brief Studio Ours JSON { situation, emotion, lieu, themeSlug?, … }
  sceneBriefJson    String?
  /// Canaux cibles cochés à la création (JSON string[]) — pilote le format d’aperçu
  channelsJson      String                     @default("[]")
  /// Carrousel CAP-2 : JSON slides[{ overlayText, poseKey?, imageSrc?, sceneKey?, textColor?, subtitleColor?, accent? }]
  slidesJson        String?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  isTestimonial     Boolean                    @default(false)
  isAttributable    Boolean                    @default(false)
  rightsAttestationId String?
  rightsAttestation CommunityRightsAttestation? @relation(fields: [rightsAttestationId], references: [id])
  videoBlobUrl      String?
  remotionComposition String?
  articleId         String?
  article           CommunityBlogArticle?      @relation(fields: [articleId], references: [id])
  assets            CommunityPublicationAsset[]
  targets           CommunityPublicationTarget[]
  notifications     CommunityFounderNotification[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, scheduledAt])
  @@index([kind])
}

model CommunityPublicationAsset {
  id            String                @id @default(cuid())
  publicationId String
  publication   CommunityPublication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  mediaId       String
  media         CommunityMediaAsset   @relation(fields: [mediaId], references: [id])
  sortOrder     Int                   @default(0)

  @@unique([publicationId, mediaId])
}

model CommunityPublicationTarget {
  id            String                 @id @default(cuid())
  publicationId String
  publication   CommunityPublication   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  accountId     String
  account       CommunitySocialAccount @relation(fields: [accountId], references: [id])
  channel       CommunitySocialChannel

  @@unique([publicationId, accountId])
}

model CommunityFounderNotification {
  id            String                @id @default(cuid())
  publicationId String?
  publication   CommunityPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime              @default(now())

  @@index([readAt, createdAt])
}

model CommunityBlogArticle {
  id              String               @id @default(cuid())
  format          CommunityGeoFormat
  status          CommunityBlogStatus  @default(brouillon)
  titleSeo        String
  metaDescription String
  slug            String               @unique
  tldr            String?
  authorName      String
  authorExpertise String
  publishedAt     DateTime?
  updatedContentAt DateTime?
  sourcesJson     String               @default("[]")
  disclaimer      String
  bodyMarkdown    String
  planJson        String?
  faqJson         String?
  howtoJson       String?
  themeId         String?
  theme           CommunityTheme?      @relation(fields: [themeId], references: [id])
  tagsJson        String               @default("[]")
  teasers         CommunityPublication[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, slug])
}

