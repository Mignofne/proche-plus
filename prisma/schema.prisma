generator client {
  provider      = "prisma-client-js"
  // Vercel serverless (Amazon Linux 2023) needs the RHEL OpenSSL 3 engine
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum ProfessionalRole {
  ergotherapeute
  kinesitherapeute
  infirmier
  educateur
  admin_etablissement
}

enum CaregiverActionType {
  realise_succes
  essaye
  doute
  aide
  note
}

enum AutonomyLevel {
  autonome
  semi_autonome_faible
  semi_autonome_eleve
  dependant
  grabataire
}

enum Skill {
  transfert
  fauteuil
  toilette
  communication
  repas
  mobilite
  autonomie
  comportement
  autre
}

enum ObjectiveStatus {
  acquis
  en_cours
  a_reprendre
  non_travaille
}

enum CaregiverStatus {
  invite
  actif
  parcours_propose_non_active
}

enum ComprehensionResult {
  clair
  doute
}

enum FeedbackOutcome {
  facile
  difficile
  non_essaye
}

enum QuestionStatus {
  en_attente
  traitee
  associee_ressource
}

enum MessageSection {
  a_retenir
  a_essayer
  a_eviter
  a_revoir_ensemble
}

enum ExercisePublicationStatus {
  brouillon
  publie
  archive
}

enum PatientExerciseStatus {
  propose
  actif
  en_cours
  reussi
  essai
  echec
  acquis
}

enum ExerciseAttemptOutcome {
  reussi
  essai
  echec
}

enum ProfessionalAlertType {
  level_change_proposed
  regression_suspected
  no_fallback
}

enum ProfessionalAlertStatus {
  ouverte
  traitee
  ignoree
}

// --- Models ---

model Establishment {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  professionals Professional[]
  patients      Patient[]
}

model User {
  id               String          @id @default(cuid())
  email            String?         @unique
  phone            String?
  passwordHash     String
  firstName        String
  lastName         String
  largeText        Boolean         @default(false)
  soberMode        Boolean         @default(false)
  onboardingDone   Boolean         @default(false)
  isPlatformAdmin  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  professional     Professional?
  caregiver        Caregiver?
}

model Professional {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            ProfessionalRole
  establishmentId String
  establishment   Establishment    @relation(fields: [establishmentId], references: [id])
  visits          VisitProfessional[]
  transmissions   Transmission[]
  questions       Question[]       @relation("QuestionProfessional")
  clinicalNotes   ClinicalNote[]
  activatedExercises PatientExercise[]
  treatedAlerts   ProfessionalAlert[] @relation("AlertTreatedBy")
}

model Caregiver {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    CaregiverStatus   @default(invite)
  patients  PatientCaregiver[]
  feedbacks CaregiverFeedback[]
  questions Question[]
  actions   CaregiverAction[]
}

model Patient {
  id              String              @id @default(cuid())
  firstName       String
  lastName        String
  autonomyLevel   AutonomyLevel       @default(semi_autonome_faible)
  girLevel        Int?
  establishmentId String
  establishment   Establishment       @relation(fields: [establishmentId], references: [id])
  caregivers      PatientCaregiver[]
  objectives      EducationalObjective[]
  visits          Visit[]
  patientExercises PatientExercise[]
  professionalAlerts ProfessionalAlert[]
  createdAt       DateTime            @default(now())
}

model PatientCaregiver {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId String
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  relationship String
  isPrimary   Boolean   @default(true)

  @@unique([patientId, caregiverId])
}

model EducationalObjective {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  skill       Skill
  status      ObjectiveStatus @default(en_cours)
  instructions String
  nextStep    String?
  isCurrent   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  transmissions Transmission[]
}

model Visit {
  id            String              @id @default(cuid())
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          DateTime            @default(now())
  professionals VisitProfessional[]
  transmission  Transmission?
}

model VisitProfessional {
  id             String       @id @default(cuid())
  visitId        String
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  @@unique([visitId, professionalId])
}

model Transmission {
  id          String               @id @default(cuid())
  visitId     String               @unique
  visit       Visit                @relation(fields: [visitId], references: [id], onDelete: Cascade)
  objectiveId String
  objective   EducationalObjective @relation(fields: [objectiveId], references: [id])
  professionalId String
  professional Professional        @relation(fields: [professionalId], references: [id])
  messages    TransmissionMessage[]
  sentAt      DateTime             @default(now())
  readAt      DateTime?
  comprehensionChecks ComprehensionCheck[]
  feedbacks   CaregiverFeedback[]
  actions     CaregiverAction[]
}

model CaregiverAction {
  id             String             @id @default(cuid())
  transmissionId String
  transmission   Transmission       @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  caregiverId    String
  caregiver      Caregiver          @relation(fields: [caregiverId], references: [id])
  type           CaregiverActionType
  stepLabel      String?
  note           String?
  createdAt      DateTime           @default(now())
}

model TransmissionMessage {
  id             String       @id @default(cuid())
  transmissionId String
  transmission   Transmission @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  section        MessageSection
  theme          String?
  content        String
}

model ComprehensionCheck {
  id             String              @id @default(cuid())
  transmissionId String
  transmission   Transmission        @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  result         ComprehensionResult
  comment        String?
  createdAt      DateTime            @default(now())
}

model CaregiverFeedback {
  id             String          @id @default(cuid())
  transmissionId String
  transmission   Transmission    @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  caregiverId    String
  caregiver      Caregiver       @relation(fields: [caregiverId], references: [id])
  outcome        FeedbackOutcome
  difficulties   String
  wantsToDiscuss Boolean         @default(false)
  treated        Boolean         @default(false)
  createdAt      DateTime        @default(now())
}

model Question {
  id             String         @id @default(cuid())
  caregiverId    String
  caregiver      Caregiver      @relation(fields: [caregiverId], references: [id])
  professionalId String?
  professional   Professional?  @relation("QuestionProfessional", fields: [professionalId], references: [id])
  text           String
  status         QuestionStatus @default(en_attente)
  answer         String?
  createdAt      DateTime       @default(now())
}

model Resource {
  id       String @id @default(cuid())
  category String
  title    String
  content  String
}

// Données professionnelles — jamais visibles par l'aidant
model ClinicalNote {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  patientId      String
  content        String
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

// --- Catalogue exercices (specs §10–12) ---

model Theme {
  id           String     @id @default(cuid())
  slug         String     @unique
  label        String
  icon         String?
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  exercises    Exercise[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Échelle A–E administrable (distincte de l'enum Patient.autonomyLevel)
model AutonomyScale {
  id           String        @id @default(cuid())
  code         String        @unique
  label        String
  patientEnum  AutonomyLevel
  displayOrder Int           @default(0)
  active       Boolean       @default(true)
  exercises    Exercise[]
}

model Exercise {
  id                   String                    @id @default(cuid())
  themeId              String
  theme                Theme                     @relation(fields: [themeId], references: [id])
  autonomyScaleId      String
  autonomyScale        AutonomyScale             @relation(fields: [autonomyScaleId], references: [id])
  tier                 Int                       @default(1)
  name                 String
  objective            String
  /// JSON string[] — étapes / guidance verbale
  steps                String
  /// JSON string[]
  caregiverCan         String
  /// JSON string[]
  caregiverMustNot     String
  estimatedDuration    String?
  risks                String?
  onSuccessExerciseId  String?
  onSuccessExercise    Exercise?                 @relation("ExerciseOnSuccess", fields: [onSuccessExerciseId], references: [id])
  successFrom          Exercise[]                @relation("ExerciseOnSuccess")
  onPartialExerciseId  String?
  onPartialExercise    Exercise?                 @relation("ExerciseOnPartial", fields: [onPartialExerciseId], references: [id])
  partialFrom          Exercise[]                @relation("ExerciseOnPartial")
  onFailureExerciseId  String?
  onFailureExercise    Exercise?                 @relation("ExerciseOnFailure", fields: [onFailureExerciseId], references: [id])
  failureFrom          Exercise[]                @relation("ExerciseOnFailure")
  crossesAutonomyLevel Boolean                   @default(false)
  alertOnFailure       Boolean                   @default(false)
  status               ExercisePublicationStatus @default(brouillon)
  version              Int                       @default(1)
  validatedBy          String?
  validatedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  patientExercises     PatientExercise[]
  alerts               ProfessionalAlert[]

  @@index([themeId, status])
  @@index([autonomyScaleId])
}

model PatientExercise {
  id            String                @id @default(cuid())
  patientId     String
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise              @relation(fields: [exerciseId], references: [id])
  currentStatus PatientExerciseStatus @default(propose)
  activatedById String?
  activatedBy   Professional?         @relation(fields: [activatedById], references: [id])
  activatedAt   DateTime?
  /// Contenu courant pour ce thème (un seul true par patient×thème côté app)
  isCurrent     Boolean               @default(false)
  history       ExerciseAttempt[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([patientId, isCurrent])
  @@unique([patientId, exerciseId])
}

model ExerciseAttempt {
  id                String                 @id @default(cuid())
  patientExerciseId String
  patientExercise   PatientExercise        @relation(fields: [patientExerciseId], references: [id], onDelete: Cascade)
  outcome           ExerciseAttemptOutcome
  note              String?
  createdAt         DateTime               @default(now())
}

model ProfessionalAlert {
  id             String                  @id @default(cuid())
  type           ProfessionalAlertType
  status         ProfessionalAlertStatus @default(ouverte)
  patientId      String
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseId     String?
  exercise       Exercise?               @relation(fields: [exerciseId], references: [id])
  nextExerciseId String?
  message        String
  treatedById    String?
  treatedBy      Professional?           @relation("AlertTreatedBy", fields: [treatedById], references: [id])
  createdAt      DateTime                @default(now())
  treatedAt      DateTime?

  @@index([patientId, status])
}
