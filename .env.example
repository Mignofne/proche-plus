# Base PostgreSQL (Neon recommandé pour GitHub + Vercel)
# Exemple Neon : postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret JWT — générer une chaîne aléatoire longue en production
# Exemple : openssl rand -base64 32
JWT_SECRET="change-me-in-production-use-long-random-string"

# Studio Ours — provider d’images (défaut = remote = vraie génération)
# mock | remote | local
MASCOT_GEN_PROVIDER="remote"
# OpenAI (recommandé pour fidélité C-v3) — sinon fallback Pollinations free
# OPENAI_API_KEY=
# MASCOT_GEN_OPENAI_API_KEY=
# MASCOT_GEN_OPENAI_MODEL="gpt-image-1"
# Webhook custom (prioritaire si défini)
# MASCOT_GEN_REMOTE_URL=
# MASCOT_GEN_REMOTE_SECRET=
# MASCOT_GEN_LOCAL_URL=
# Stockage des images générées (recommandé en prod Vercel)
# BLOB_READ_WRITE_TOKEN=
