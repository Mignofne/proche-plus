# Base PostgreSQL (Neon recommandé pour GitHub + Vercel)
# Exemple Neon : postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret JWT — générer une chaîne aléatoire longue en production
# Exemple : openssl rand -base64 32
JWT_SECRET="change-me-in-production-use-long-random-string"
